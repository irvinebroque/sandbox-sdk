# R2 S3-compatible credentials for presigned URL generation
# 
# These are NOT regular Cloudflare API tokens - they're S3-compatible credentials.
#
# To get these credentials:
# 1. Go to https://dash.cloudflare.com/?to=/:account/r2/api-tokens
# 2. Click "Create API Token"
# 3. Select "Object Read & Write" permission
# 4. Copy the Access Key ID and Secret Access Key (shown only once!)
# 5. Get your Account ID from the dashboard URL (after /accounts/)
#
# Copy this file to .dev.vars and fill in your values

CF_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=sandbox-snapshots
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
