{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "d0993424a8581ca2137e799fe64cc492",
  "name": "sandbox-volume-snapshot-example",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // R2 bucket for storing volume snapshots
  // Create with: npx wrangler r2 bucket create sandbox-snapshots
  "r2_buckets": [
    {
      "bucket_name": "sandbox-snapshots",
      "binding": "SNAPSHOTS",
      "remote": true
    }
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard-3",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox"],
      "tag": "v1"
    }
  ]
}
